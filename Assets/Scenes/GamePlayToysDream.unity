  m_EditorClassIdentifier: 
  dialogID: bialog_pickup_box01
  dialogSequence:
  - dialogText: 'Son : Well, if you stuck or make a mistake you can tell me anytime.'
    dialogVoice: {fileID: 0}
    focusTarget: {fileID: 0}
    shakeCamera: 0
    isHint: 0
    hintUIElement: {fileID: 0}
    displayDuration: 5
  - dialogText: 'Son : I will restart the level for you'
    dialogVoice: {fileID: 0}
    focusTarget: {fileID: 0}
    shakeCamera: 0
    isHint: 0
    hintUIElement: {fileID: 0}
    displayDuration: 5
  - dialogText: "Dad : This hero is already so skilled \u2014 he probably won\u2019t
      need to use it anyway."
    dialogVoice: {fileID: 0}
    focusTarget: {fileID: 0}
    shakeCamera: 0
    isHint: 0
    hintUIElement: {fileID: 0}
    displayDuration: 5
  - dialogText: 'Son : We will see about that !'
    dialogVoice: {fileID: 0}
    focusTarget: {fileID: 0}
    shakeCamera: 0
    isHint: 0
    hintUIElement: {fileID: 0}
    displayDuration: 5
  triggerOnce: 1
  freezePlayerOnStart: 0
  rememberAcrossScenes: 0
  useDelay: 0
  delay: 1.5
  autoAdvance: 1
  autoAdvanceDelay: 1.5
  onDialogComplete:
    m_PersistentCalls:
