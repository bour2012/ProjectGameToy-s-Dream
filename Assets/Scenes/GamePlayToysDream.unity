  m_Name: 
  m_EditorClassIdentifier: 
  dialogID: bialog_push_box01
  dialogSequence:
  - dialogText: 'Son : But before he could reach the town, the hero had to overcome
      many obstacles and trials along the way.'
    dialogVoice: {fileID: 0}
    focusTarget: {fileID: 0}
    waitForCamera: 0
    cameraSmoothness: 1
    changeZoom: 0
    targetLensSize: 40
    zoomDuration: 1
    shakeCamera: 0
    useFadeCut: 0
    fadeDuration: 0.5
    fadeHoldDuration: 0.5
    isHint: 0
    hintUIElement: {fileID: 0}
    displayDuration: 5
    onLineStart:
      m_PersistentCalls:
        m_Calls: []
  - dialogText: 'Dad : How far away is the town bud ?'
    dialogVoice: {fileID: 0}
    focusTarget: {fileID: 0}
    waitForCamera: 0
    cameraSmoothness: 1
    changeZoom: 0
    targetLensSize: 40
    zoomDuration: 1
    shakeCamera: 0
    useFadeCut: 0
    fadeDuration: 0.5
    fadeHoldDuration: 0.5
    isHint: 0
    hintUIElement: {fileID: 0}
    displayDuration: 5
    onLineStart:
      m_PersistentCalls:
        m_Calls: []
  - dialogText: 'Son : The hero must not complain and must press on with courage
      in his heart. (Whisper) you have to roleplay dad !'
    dialogVoice: {fileID: 0}
    focusTarget: {fileID: 0}
    waitForCamera: 0
    cameraSmoothness: 1
    changeZoom: 0
    targetLensSize: 40
    zoomDuration: 1
    shakeCamera: 0
    useFadeCut: 0
    fadeDuration: 0.5
    fadeHoldDuration: 0.5
    isHint: 0
    hintUIElement: {fileID: 0}
    displayDuration: 5
    onLineStart:
      m_PersistentCalls:
        m_Calls: []
  - dialogText: 'Dad : (Whisper) Sorry, my bad (speak normally) I will overcome this
      obstacles and save the town !'
    dialogVoice: {fileID: 0}
    focusTarget: {fileID: 0}
    waitForCamera: 0
    cameraSmoothness: 1
    changeZoom: 0
    targetLensSize: 40
    zoomDuration: 1
    shakeCamera: 0
    useFadeCut: 0
    fadeDuration: 0.5
    fadeHoldDuration: 0.5
    isHint: 0
    hintUIElement: {fileID: 0}
    displayDuration: 5
    onLineStart:
      m_PersistentCalls:
        m_Calls: []
