  m_Name: 
  m_EditorClassIdentifier: 
  dialogID: Trigger_Dialog07
  dialogSequence:
  - dialogText: 'Dad : That move just now looked just like a certain web-slinging
      hero'
    dialogVoice: {fileID: 0}
    focusTarget: {fileID: 0}
    shakeCamera: 0
    isHint: 0
    hintUIElement: {fileID: 0}
    displayDuration: 5
  - dialogText: "Son : That one uses web powers, but this one uses thread- they don\u2019t
      look alike at all !"
    dialogVoice: {fileID: 0}
    focusTarget: {fileID: 0}
    shakeCamera: 0
    isHint: 0
    hintUIElement: {fileID: 0}
    displayDuration: 5
  triggerOnce: 1
  freezePlayerOnStart: 1
