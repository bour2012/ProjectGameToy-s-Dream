  m_EditorClassIdentifier: 
  dialogID: Trigger_Dialog12
  dialogSequence:
  - dialogText: 'Dad: That looks like the way forward... seems like we need to activate
      a switch.'
    dialogVoice: {fileID: 0}
    focusTarget: {fileID: 635189583}
    shakeCamera: 0
    isHint: 0
    hintUIElement: {fileID: 0}
    displayDuration: 5
  - dialogText: "Son : Shh \u2014 it hasn't seen us yet"
    dialogVoice: {fileID: 0}
    focusTarget: {fileID: 0}
    shakeCamera: 0
    isHint: 0
    hintUIElement: {fileID: 0}
    displayDuration: 5
  - dialogText: 'Dad : let''s use thread to make a doll to lure it away then'
    dialogVoice: {fileID: 0}
    focusTarget: {fileID: 0}
    shakeCamera: 0
    isHint: 0
    hintUIElement: {fileID: 0}
    displayDuration: 5
  - dialogText: "Son : Just as expected of a hero \u2014 what a brilliant idea !"
    dialogVoice: {fileID: 0}
    focusTarget: {fileID: 0}
    shakeCamera: 0
    isHint: 0
    hintUIElement: {fileID: 0}
    displayDuration: 5
  triggerOnce: 1
  freezePlayerOnStart: 1
  rememberAcrossScenes: 1
  useDelay: 1
  delay: 0.21
  autoAdvance: 1
  autoAdvanceDelay: 2.5
  onDialogComplete:
    m_PersistentCalls:
