    dialogVoice: {fileID: 0}
    focusTarget: {fileID: 1285374577}
    shakeCamera: 0
    isHint: 0
    hintUIElement: {fileID: 0}
    displayDuration: 5
  - dialogText: "Dad : Then, it\u2019s time to use this glue power !!"
