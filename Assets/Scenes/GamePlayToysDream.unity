MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1523474951}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7e35b898002c22947af915cf704e2830, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogID: bialog_push_box01
  dialogSequence:
  - dialogText: 'Son : But before he could reach the town, the hero had to overcome
      many obstacles and trials along the way.'
    dialogVoice: {fileID: 0}
    focusTarget: {fileID: 0}
    shakeCamera: 0
    isHint: 0
    hintUIElement: {fileID: 0}
    displayDuration: 5
  - dialogText: 'Dad : How far away is the town bud ?'
    dialogVoice: {fileID: 0}
    focusTarget: {fileID: 0}
    shakeCamera: 0
    isHint: 0
    hintUIElement: {fileID: 0}
    displayDuration: 5
  - dialogText: 'Son : The hero must not complain and must press on with courage
      in his heart. (Whisper) you have to roleplay dad !'
    dialogVoice: {fileID: 0}
    focusTarget: {fileID: 0}
    shakeCamera: 0
    isHint: 0
    hintUIElement: {fileID: 0}
    displayDuration: 5
  - dialogText: 'Dad : (Whisper) Sorry, my bad (speak normally) I will overcome this
      obstacles and save the town !'
    dialogVoice: {fileID: 0}
    focusTarget: {fileID: 0}
    shakeCamera: 0
    isHint: 0
    hintUIElement: {fileID: 0}
    displayDuration: 5
  triggerOnce: 1
  freezePlayerOnStart: 1
  rememberAcrossScenes: 0
  useDelay: 1
  delay: 0.85
  autoAdvance: 1
  autoAdvanceDelay: 1.5
  onDialogComplete:
    m_PersistentCalls:
      m_Calls: []
