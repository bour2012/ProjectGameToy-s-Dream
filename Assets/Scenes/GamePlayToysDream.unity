  m_Name: 
  m_EditorClassIdentifier: 
  dialogID: Trigger_Dialog12
  dialogSequence:
  - dialogText: 'Dad: That looks like the way forward... seems like we need to activate
      a switch.'
    dialogVoice: {fileID: 0}
    focusTarget: {fileID: 635189583}
    waitForCamera: 0
    cameraSmoothness: 1
    changeZoom: 0
    targetLensSize: 40
    zoomDuration: 1
    shakeCamera: 0
    useFadeCut: 0
    fadeDuration: 0.5
    fadeHoldDuration: 0.5
    isHint: 0
    hintUIElement: {fileID: 0}
    displayDuration: 5
    onLineStart:
      m_PersistentCalls:
        m_Calls: []
  - dialogText: "Son : Shh \u2014 it hasn't seen us yet"
    dialogVoice: {fileID: 0}
    focusTarget: {fileID: 1083704200}
    waitForCamera: 0
    cameraSmoothness: 1
    changeZoom: 0
    targetLensSize: 40
    zoomDuration: 1
    shakeCamera: 0
    useFadeCut: 0
    fadeDuration: 0.5
    fadeHoldDuration: 0.5
    isHint: 0
    hintUIElement: {fileID: 0}
    displayDuration: 5
    onLineStart:
      m_PersistentCalls:
        m_Calls: []
  - dialogText: 'Dad : let''s use thread to make a doll to lure it away then'
    dialogVoice: {fileID: 0}
    focusTarget: {fileID: 0}
    waitForCamera: 0
    cameraSmoothness: 1
    changeZoom: 0
    targetLensSize: 40
    zoomDuration: 1
    shakeCamera: 0
    useFadeCut: 0
    fadeDuration: 0.5
    fadeHoldDuration: 0.5
    isHint: 0
    hintUIElement: {fileID: 0}
    displayDuration: 5
    onLineStart:
      m_PersistentCalls:
        m_Calls: []
  - dialogText: "Son : Just as expected of a hero \u2014 what a brilliant idea !"
    dialogVoice: {fileID: 0}
    focusTarget: {fileID: 0}
    waitForCamera: 0
    cameraSmoothness: 1
    changeZoom: 0
    targetLensSize: 40
    zoomDuration: 1
    shakeCamera: 0
    useFadeCut: 0
    fadeDuration: 0.5
    fadeHoldDuration: 0.5
    isHint: 0
    hintUIElement: {fileID: 0}
    displayDuration: 5
    onLineStart:
      m_PersistentCalls:
        m_Calls: []
  triggerOnce: 1
  freezePlayerOnStart: 1
  rememberAcrossScenes: 1
  useDelay: 1
