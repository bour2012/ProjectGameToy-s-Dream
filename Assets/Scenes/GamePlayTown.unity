  m_Script: {fileID: 11500000, guid: 7e35b898002c22947af915cf704e2830, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogID: 
  dialogSequence:
  - dialogText: "\rBear leader : Oh hero, You're finally arrive !"
    currentVoice: {fileID: 0}
    typingSound: {fileID: 8300000, guid: 987f1009730310d4480fc9b2c4263ddf, type: 3}
    playSoundFrequency: 5
    randomizePitch: 0
    pitchRange: {x: 0.9, y: 1.1}
    focusTarget: {fileID: 0}
    waitForCamera: 0
    cameraSmoothness: 1
    changeZoom: 0
    targetLensSize: 40
    zoomDuration: 1
    shakeCamera: 0
    useFadeCut: 0
    fadeDuration: 0.5
    fadeHoldDuration: 0.5
    isHint: 0
    hintUIElement: {fileID: 0}
    displayDuration: 5
    onLineStart:
      m_PersistentCalls:
        m_Calls: []
  - dialogText: "\rBear leader : Our village is in dire need of your help !"
    currentVoice: {fileID: 0}
    typingSound: {fileID: 8300000, guid: 987f1009730310d4480fc9b2c4263ddf, type: 3}
    playSoundFrequency: 5
    randomizePitch: 0
    pitchRange: {x: 0.9, y: 1.1}
    focusTarget: {fileID: 0}
    waitForCamera: 0
    cameraSmoothness: 1
    changeZoom: 0
    targetLensSize: 40
    zoomDuration: 1
    shakeCamera: 0
    useFadeCut: 0
    fadeDuration: 0.5
    fadeHoldDuration: 0.5
    isHint: 0
    hintUIElement: {fileID: 0}
    displayDuration: 5
    onLineStart:
      m_PersistentCalls:
        m_Calls: []
  - dialogText: "\rDad : What happen ?"
    currentVoice: {fileID: 11400000, guid: 62bec4f1950ebc044b533f13b14b2e03, type: 2}
    typingSound: {fileID: 0}
    playSoundFrequency: 5
    randomizePitch: 0
    pitchRange: {x: 0.9, y: 1.1}
    focusTarget: {fileID: 0}
    waitForCamera: 0
    cameraSmoothness: 1
    changeZoom: 0
    targetLensSize: 40
    zoomDuration: 1
    shakeCamera: 0
    useFadeCut: 0
    fadeDuration: 0.5
    fadeHoldDuration: 0.5
    isHint: 0
    hintUIElement: {fileID: 0}
    displayDuration: 5
    onLineStart:
      m_PersistentCalls:
        m_Calls: []
  - dialogText: "\rBear leader : The demon have attack our village and kidnaped the
      town's people !"
    currentVoice: {fileID: 0}
    typingSound: {fileID: 8300000, guid: 987f1009730310d4480fc9b2c4263ddf, type: 3}
    playSoundFrequency: 5
    randomizePitch: 0
    pitchRange: {x: 0.9, y: 1.1}
    focusTarget: {fileID: 0}
    waitForCamera: 0
    cameraSmoothness: 1
    changeZoom: 0
    targetLensSize: 40
    zoomDuration: 1
    shakeCamera: 0
    useFadeCut: 0
    fadeDuration: 0.5
    fadeHoldDuration: 0.5
    isHint: 0
    hintUIElement: {fileID: 0}
    displayDuration: 5
    onLineStart:
      m_PersistentCalls:
        m_Calls: []
  - dialogText: "\rBear leader : You've to go help them"
    currentVoice: {fileID: 0}
    typingSound: {fileID: 8300000, guid: 987f1009730310d4480fc9b2c4263ddf, type: 3}
    playSoundFrequency: 5
    randomizePitch: 0
    pitchRange: {x: 0.9, y: 1.1}
    focusTarget: {fileID: 0}
    waitForCamera: 0
    cameraSmoothness: 1
    changeZoom: 0
    targetLensSize: 40
    zoomDuration: 1
    shakeCamera: 0
    useFadeCut: 0
    fadeDuration: 0.5
    fadeHoldDuration: 0.5
    isHint: 0
    hintUIElement: {fileID: 0}
    displayDuration: 5
    onLineStart:
      m_PersistentCalls:
        m_Calls: []
  - dialogText: "\rBear leader : Please, you're our only hope !"
    currentVoice: {fileID: 0}
    typingSound: {fileID: 8300000, guid: 987f1009730310d4480fc9b2c4263ddf, type: 3}
    playSoundFrequency: 5
    randomizePitch: 0
    pitchRange: {x: 0.9, y: 1.1}
    focusTarget: {fileID: 0}
    waitForCamera: 0
    cameraSmoothness: 1
    changeZoom: 0
    targetLensSize: 40
    zoomDuration: 1
    shakeCamera: 0
    useFadeCut: 0
    fadeDuration: 0.5
    fadeHoldDuration: 0.5
    isHint: 0
    hintUIElement: {fileID: 0}
    displayDuration: 5
    onLineStart:
      m_PersistentCalls:
        m_Calls: []
  - dialogText: "\rDad : Don't worry. I will go and help them now.\r\n"
    currentVoice: {fileID: 11400000, guid: 62bec4f1950ebc044b533f13b14b2e03, type: 2}
    typingSound: {fileID: 0}
    playSoundFrequency: 5
    randomizePitch: 0
    pitchRange: {x: 0.9, y: 1.1}
    focusTarget: {fileID: 0}
    waitForCamera: 0
    cameraSmoothness: 1
    changeZoom: 0
    targetLensSize: 40
    zoomDuration: 1
    shakeCamera: 0
    useFadeCut: 0
    fadeDuration: 0.5
    fadeHoldDuration: 0.5
    isHint: 0
    hintUIElement: {fileID: 0}
    displayDuration: 5
    onLineStart:
      m_PersistentCalls:
        m_Calls: []
  - dialogText: "\rBear leader : Thank you, I'm counting on you hero !"
    currentVoice: {fileID: 0}
    typingSound: {fileID: 8300000, guid: 987f1009730310d4480fc9b2c4263ddf, type: 3}
    playSoundFrequency: 5
    randomizePitch: 0
    pitchRange: {x: 0.9, y: 1.1}
