    displayDuration: 5
    onLineStart:
      m_PersistentCalls:
        m_Calls: []
  - dialogText: 'Demon Lord : If you continue to interfere with my plan, there shall
      be consequences! !'
    currentVoice: {fileID: 0}
    typingSound: {fileID: 8300000, guid: df1af8d7a0eda4341a686db3e72c1f7a, type: 3}
