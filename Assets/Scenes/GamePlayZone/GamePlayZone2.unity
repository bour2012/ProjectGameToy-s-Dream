--- !u!114 &1120448810
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1120448807}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7e35b898002c22947af915cf704e2830, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogID: 
  dialogSequence:
  - dialogText: 'Son : Let''s go save the rest of the townspeople!'
    currentVoice: {fileID: 11400000, guid: 16c23f38c9c721a43b13dbef2817c2c4, type: 2}
    typingSound: {fileID: 0}
    playSoundFrequency: 2
    randomizePitch: 1
    pitchRange: {x: 0.9, y: 1.1}
    focusTarget: {fileID: 0}
    waitForCamera: 0
    cameraSmoothness: 1
    changeZoom: 0
    targetLensSize: 40
    zoomDuration: 1
    shakeCamera: 0
    useFadeCut: 0
    fadeDuration: 0.5
    fadeHoldDuration: 0.5
    isHint: 0
    hintUIElement: {fileID: 0}
    displayDuration: 5
    onLineStart:
      m_PersistentCalls:
        m_Calls: []
  - dialogText: "Dad : Wait, Is that...a laser?\r"
    currentVoice: {fileID: 11400000, guid: 62bec4f1950ebc044b533f13b14b2e03, type: 2}
    typingSound: {fileID: 0}
    playSoundFrequency: 2
    randomizePitch: 1
    pitchRange: {x: 0.9, y: 1.1}
    focusTarget: {fileID: 0}
    waitForCamera: 0
    cameraSmoothness: 1
    changeZoom: 0
    targetLensSize: 40
    zoomDuration: 1
    shakeCamera: 0
    useFadeCut: 0
    fadeDuration: 0.5
    fadeHoldDuration: 0.5
    isHint: 0
    hintUIElement: {fileID: 0}
    displayDuration: 5
    onLineStart:
      m_PersistentCalls:
        m_Calls: []
  - dialogText: "Son : No! That\u2019s a high-destruction atomic light beam! The
      one you bought for me yesterday!"
    currentVoice: {fileID: 11400000, guid: 16c23f38c9c721a43b13dbef2817c2c4, type: 2}
    typingSound: {fileID: 0}
    playSoundFrequency: 2
    randomizePitch: 1
    pitchRange: {x: 0.9, y: 1.1}
    focusTarget: {fileID: 0}
    waitForCamera: 0
    cameraSmoothness: 1
    changeZoom: 0
    targetLensSize: 40
    zoomDuration: 1
    shakeCamera: 0
    useFadeCut: 0
    fadeDuration: 0.5
    fadeHoldDuration: 0.5
    isHint: 0
    hintUIElement: {fileID: 0}
    displayDuration: 5
    onLineStart:
      m_PersistentCalls:
        m_Calls: []
  - dialogText: "Son : Hmm... Maybe <color=#FFD700>that new box you got from the
      town chief can withstand its power.</color> \r\n"
    currentVoice: {fileID: 11400000, guid: 16c23f38c9c721a43b13dbef2817c2c4, type: 2}
    typingSound: {fileID: 0}
    playSoundFrequency: 2
    randomizePitch: 1
    pitchRange: {x: 0.9, y: 1.1}
    focusTarget: {fileID: 0}
    waitForCamera: 0
    cameraSmoothness: 1
    changeZoom: 0
    targetLensSize: 40
    zoomDuration: 1
    shakeCamera: 0
    useFadeCut: 0
    fadeDuration: 0.5
    fadeHoldDuration: 0.5
    isHint: 0
    hintUIElement: {fileID: 0}
    displayDuration: 5
    onLineStart:
      m_PersistentCalls:
        m_Calls: []
  triggerOnce: 1
  freezePlayerOnStart: 1
  rememberAcrossScenes: 0
