            m_FloatArgument: 0
            m_StringArgument: 1
            m_BoolArgument: 0
          m_CallState: 2
  - dialogText: 'Demon Lord : But you will never get past the traps I have set up
      ahead!'
    currentVoice: {fileID: 0}
    typingSound: {fileID: 8300000, guid: df1af8d7a0eda4341a686db3e72c1f7a, type: 3}
