  m_Script: {fileID: 11500000, guid: 7e35b898002c22947af915cf704e2830, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogID: Trigger_Dialog09
  dialogSequence:
  - dialogText: 'Son : We have to stop him before he harms the townspeople!'
    currentVoice: {fileID: 11400000, guid: 16c23f38c9c721a43b13dbef2817c2c4, type: 2}
    typingSound: {fileID: 0}
    playSoundFrequency: 0
    randomizePitch: 0
    pitchRange: {x: 0, y: 0}
    focusTarget: {fileID: 0}
    waitForCamera: 0
    cameraSmoothness: 0
    changeZoom: 0
    targetLensSize: 0
    zoomDuration: 0
    shakeCamera: 0
    useFadeCut: 0
    fadeDuration: 0
    fadeHoldDuration: 0
    isHint: 0
    hintUIElement: {fileID: 0}
    displayDuration: 0
    onLineStart:
      m_PersistentCalls:
        m_Calls: []
  - dialogText: 'Dad : But how...?'
    currentVoice: {fileID: 11400000, guid: 62bec4f1950ebc044b533f13b14b2e03, type: 2}
    typingSound: {fileID: 0}
    playSoundFrequency: 0
    randomizePitch: 0
    pitchRange: {x: 0, y: 0}
    focusTarget: {fileID: 0}
    waitForCamera: 0
    cameraSmoothness: 0
    changeZoom: 0
    targetLensSize: 0
    zoomDuration: 0
    shakeCamera: 0
    useFadeCut: 0
    fadeDuration: 0
    fadeHoldDuration: 0
    isHint: 0
    hintUIElement: {fileID: 0}
    displayDuration: 0
    onLineStart:
      m_PersistentCalls:
        m_Calls: []
  - dialogText: 'Son : I have an idea. If we <color=#FFD700>collect the broken parts
      of the glue cannon and repair it...</color> '
    currentVoice: {fileID: 11400000, guid: 16c23f38c9c721a43b13dbef2817c2c4, type: 2}
    typingSound: {fileID: 0}
    playSoundFrequency: 1
    randomizePitch: 0
    pitchRange: {x: 0, y: 0}
    focusTarget: {fileID: 1893969003}
    waitForCamera: 1
    cameraSmoothness: 5
    changeZoom: 1
    targetLensSize: 40
    zoomDuration: 0
    shakeCamera: 0
    useFadeCut: 0
    fadeDuration: 0
    fadeHoldDuration: 0
    isHint: 0
    hintUIElement: {fileID: 0}
    displayDuration: 0
    onLineStart:
      m_PersistentCalls:
        m_Calls: []
  - dialogText: 'Son : We can use the cannon to beat the Demon Lord!'
    currentVoice: {fileID: 11400000, guid: 16c23f38c9c721a43b13dbef2817c2c4, type: 2}
    typingSound: {fileID: 0}
    playSoundFrequency: 0
    randomizePitch: 0
    pitchRange: {x: 0, y: 0}
    focusTarget: {fileID: 0}
    waitForCamera: 0
    cameraSmoothness: 0
    changeZoom: 0
    targetLensSize: 0
    zoomDuration: 0
    shakeCamera: 0
    useFadeCut: 0
    fadeDuration: 0
    fadeHoldDuration: 0
    isHint: 0
    hintUIElement: {fileID: 0}
    displayDuration: 0
    onLineStart:
      m_PersistentCalls:
        m_Calls: []
  - dialogText: 'Son : We have to <color=#FFD700>collect three parts in each level.</color> 
      Good luck!'
    currentVoice: {fileID: 11400000, guid: 16c23f38c9c721a43b13dbef2817c2c4, type: 2}
    typingSound: {fileID: 0}
    playSoundFrequency: 1
    randomizePitch: 0
    pitchRange: {x: 0, y: 0}
    focusTarget: {fileID: 1857334467}
