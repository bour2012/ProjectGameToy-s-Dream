  m_Name: 
  m_EditorClassIdentifier: 
  dialogID: bialog_pickup_box01
  dialogSequence:
  - dialogText: 'Son : Well, if you get stuck or make a mistake, just tell me anytime.'
    currentVoice: {fileID: 11400000, guid: 16c23f38c9c721a43b13dbef2817c2c4, type: 2}
    typingSound: {fileID: 0}
    playSoundFrequency: 2
    randomizePitch: 1
    pitchRange: {x: 0.9, y: 1.1}
    focusTarget: {fileID: 0}
    waitForCamera: 0
    cameraSmoothness: 1
    changeZoom: 0
    targetLensSize: 40
    zoomDuration: 1
    shakeCamera: 0
    useFadeCut: 0
    fadeDuration: 0.5
    fadeHoldDuration: 0.5
    isHint: 0
    hintUIElement: {fileID: 0}
    displayDuration: 5
    onLineStart:
      m_PersistentCalls:
        m_Calls: []
  - dialogText: 'Son : I will <color=#FFD700>restart</color> the level for you.'
    currentVoice: {fileID: 11400000, guid: 16c23f38c9c721a43b13dbef2817c2c4, type: 2}
    typingSound: {fileID: 0}
    playSoundFrequency: 2
    randomizePitch: 1
    pitchRange: {x: 0.9, y: 1.1}
    focusTarget: {fileID: 0}
    waitForCamera: 0
    cameraSmoothness: 1
    changeZoom: 0
    targetLensSize: 40
    zoomDuration: 1
    shakeCamera: 0
    useFadeCut: 0
    fadeDuration: 0.5
    fadeHoldDuration: 0.5
    isHint: 0
    hintUIElement: {fileID: 0}
    displayDuration: 5
    onLineStart:
      m_PersistentCalls:
        m_Calls: []
  - dialogText: 'Dad : This hero is already so skilled. He probably won''t need your
      help anyway.'
    currentVoice: {fileID: 0}
    typingSound: {fileID: 0}
    playSoundFrequency: 2
    randomizePitch: 1
    pitchRange: {x: 0.9, y: 1.1}
    focusTarget: {fileID: 0}
    waitForCamera: 0
    cameraSmoothness: 1
    changeZoom: 0
    targetLensSize: 40
    zoomDuration: 1
    shakeCamera: 0
    useFadeCut: 0
    fadeDuration: 0.5
    fadeHoldDuration: 0.5
    isHint: 0
    hintUIElement: {fileID: 0}
    displayDuration: 5
    onLineStart:
      m_PersistentCalls:
        m_Calls: []
  - dialogText: 'Son : We will see about that!'
    currentVoice: {fileID: 11400000, guid: 16c23f38c9c721a43b13dbef2817c2c4, type: 2}
    typingSound: {fileID: 0}
    playSoundFrequency: 2
    randomizePitch: 1
