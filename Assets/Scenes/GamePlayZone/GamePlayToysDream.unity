  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7e35b898002c22947af915cf704e2830, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogID: Trigger_Dialog12
  dialogSequence:
  - dialogText: 'Dad: That looks like the way forward... seems like we need to activate
      a switch.'
    currentVoice: {fileID: 11400000, guid: 62bec4f1950ebc044b533f13b14b2e03, type: 2}
    typingSound: {fileID: 0}
    playSoundFrequency: 2
    randomizePitch: 1
    pitchRange: {x: 0.9, y: 1.1}
    focusTarget: {fileID: 635189583}
    waitForCamera: 1
    cameraSmoothness: 3
    changeZoom: 1
    targetLensSize: 55
    zoomDuration: 2
    shakeCamera: 0
    useFadeCut: 0
    fadeDuration: 0.5
    fadeHoldDuration: 2
    isHint: 0
    hintUIElement: {fileID: 0}
    displayDuration: 5
    onLineStart:
      m_PersistentCalls:
        m_Calls: []
  - dialogText: 
    currentVoice: {fileID: 0}
    typingSound: {fileID: 0}
    playSoundFrequency: 2
    randomizePitch: 1
    pitchRange: {x: 0.9, y: 1.1}
    focusTarget: {fileID: 0}
    waitForCamera: 0
    cameraSmoothness: 1
    changeZoom: 0
    targetLensSize: 40
    zoomDuration: 1
    shakeCamera: 0
    useFadeCut: 1
    fadeDuration: 0.5
    fadeHoldDuration: 2
    isHint: 0
    hintUIElement: {fileID: 0}
    displayDuration: 5
    onLineStart:
      m_PersistentCalls:
        m_Calls: []
  - dialogText: "Son : Shhh\u2026! It hasn't seen us yet\u2026"
    currentVoice: {fileID: 11400000, guid: 16c23f38c9c721a43b13dbef2817c2c4, type: 2}
    typingSound: {fileID: 0}
    playSoundFrequency: 2
    randomizePitch: 1
    pitchRange: {x: 0.9, y: 1.1}
    focusTarget: {fileID: 1083704200}
    waitForCamera: 1
    cameraSmoothness: 2
    changeZoom: 1
    targetLensSize: 30
    zoomDuration: 1
    shakeCamera: 0
    useFadeCut: 0
    fadeDuration: 0.5
    fadeHoldDuration: 0.5
    isHint: 0
    hintUIElement: {fileID: 0}
    displayDuration: 5
    onLineStart:
      m_PersistentCalls:
        m_Calls: []
  - dialogText: 'Dad : Hey, why not use <color=#FFD700>thread</color> on that pile
      of scraps? We could make a doll to lure the monsters away.'
    currentVoice: {fileID: 0}
    typingSound: {fileID: 0}
    playSoundFrequency: 2
    randomizePitch: 1
    pitchRange: {x: 0.9, y: 1.1}
    focusTarget: {fileID: 0}
    waitForCamera: 0
    cameraSmoothness: 1
    changeZoom: 0
    targetLensSize: 40
    zoomDuration: 1
    shakeCamera: 0
    useFadeCut: 0
    fadeDuration: 0.5
    fadeHoldDuration: 0.5
    isHint: 0
    hintUIElement: {fileID: 0}
    displayDuration: 5
    onLineStart:
      m_PersistentCalls:
        m_Calls: []
  - dialogText: "Son : Just as expected of the hero\u2026! What a brilliant idea!"
    currentVoice: {fileID: 0}
    typingSound: {fileID: 0}
    playSoundFrequency: 2
    randomizePitch: 1
    pitchRange: {x: 0.9, y: 1.1}
    focusTarget: {fileID: 0}
    waitForCamera: 0
    cameraSmoothness: 1
    changeZoom: 0
    targetLensSize: 40
    zoomDuration: 1
    shakeCamera: 0
    useFadeCut: 0
    fadeDuration: 0.5
    fadeHoldDuration: 0.5
    isHint: 0
    hintUIElement: {fileID: 0}
    displayDuration: 5
    onLineStart:
      m_PersistentCalls:
        m_Calls: []
  triggerOnce: 1
  freezePlayerOnStart: 1
  rememberAcrossScenes: 1
  useDelay: 1
  delay: 0.21
  autoAdvance: 1
