  m_Name: 
  m_EditorClassIdentifier: 
  dialogID: bialog_push_box01
  dialogSequence:
  - dialogText: 'Son : But before he can reach the town, he has to overcome many
      obstacles along the way!'
    currentVoice: {fileID: 11400000, guid: 16c23f38c9c721a43b13dbef2817c2c4, type: 2}
    typingSound: {fileID: 0}
    playSoundFrequency: 2
    randomizePitch: 1
    pitchRange: {x: 0.9, y: 1.1}
    focusTarget: {fileID: 0}
    waitForCamera: 0
    cameraSmoothness: 1
    changeZoom: 0
    targetLensSize: 40
    zoomDuration: 1
    shakeCamera: 0
    useFadeCut: 0
    fadeDuration: 0.5
    fadeHoldDuration: 0.5
    isHint: 0
    hintUIElement: {fileID: 0}
    displayDuration: 5
    onLineStart:
      m_PersistentCalls:
        m_Calls: []
  - dialogText: 'Dad : How far is this town, anyway?'
    currentVoice: {fileID: 11400000, guid: 62bec4f1950ebc044b533f13b14b2e03, type: 2}
    typingSound: {fileID: 0}
    playSoundFrequency: 2
    randomizePitch: 1
    pitchRange: {x: 0.9, y: 1.1}
    focusTarget: {fileID: 0}
    waitForCamera: 0
    cameraSmoothness: 1
    changeZoom: 0
    targetLensSize: 40
    zoomDuration: 1
    shakeCamera: 0
    useFadeCut: 0
    fadeDuration: 0.5
    fadeHoldDuration: 0.5
    isHint: 0
    hintUIElement: {fileID: 0}
    displayDuration: 5
    onLineStart:
      m_PersistentCalls:
        m_Calls: []
  - dialogText: 'Son : A hero must not complain and keep going bravely!'
    currentVoice: {fileID: 11400000, guid: 16c23f38c9c721a43b13dbef2817c2c4, type: 2}
    typingSound: {fileID: 0}
    playSoundFrequency: 2
    randomizePitch: 1
    pitchRange: {x: 0.9, y: 1.1}
    focusTarget: {fileID: 0}
    waitForCamera: 0
    cameraSmoothness: 1
    changeZoom: 0
    targetLensSize: 40
    zoomDuration: 1
    shakeCamera: 0
    useFadeCut: 0
    fadeDuration: 0.5
    fadeHoldDuration: 0.5
    isHint: 0
    hintUIElement: {fileID: 0}
    displayDuration: 5
    onLineStart:
      m_PersistentCalls:
        m_Calls: []
  - dialogText: 'Son : You have to roleplay, dad!'
    currentVoice: {fileID: 11400000, guid: 16c23f38c9c721a43b13dbef2817c2c4, type: 2}
    typingSound: {fileID: 0}
    playSoundFrequency: 2
    randomizePitch: 1
    pitchRange: {x: 0.9, y: 1.1}
    focusTarget: {fileID: 0}
    waitForCamera: 0
    cameraSmoothness: 1
    changeZoom: 0
    targetLensSize: 40
    zoomDuration: 1
    shakeCamera: 0
    useFadeCut: 0
    fadeDuration: 0.5
    fadeHoldDuration: 0.5
    isHint: 0
    hintUIElement: {fileID: 0}
    displayDuration: 5
    onLineStart:
      m_PersistentCalls:
        m_Calls: []
  - dialogText: 'Dad : Sorry, my bad...'
    currentVoice: {fileID: 11400000, guid: 62bec4f1950ebc044b533f13b14b2e03, type: 2}
    typingSound: {fileID: 0}
    playSoundFrequency: 2
    randomizePitch: 1
    pitchRange: {x: 0.9, y: 1.1}
    focusTarget: {fileID: 0}
    waitForCamera: 0
    cameraSmoothness: 1
    changeZoom: 0
    targetLensSize: 40
    zoomDuration: 1
    shakeCamera: 0
    useFadeCut: 0
    fadeDuration: 0.5
    fadeHoldDuration: 0.5
    isHint: 0
    hintUIElement: {fileID: 0}
    displayDuration: 5
    onLineStart:
      m_PersistentCalls:
        m_Calls: []
  - dialogText: 'Dad : I will overcome this obstacle and save the town!'
    currentVoice: {fileID: 11400000, guid: 62bec4f1950ebc044b533f13b14b2e03, type: 2}
    typingSound: {fileID: 0}
    playSoundFrequency: 2
    randomizePitch: 1
